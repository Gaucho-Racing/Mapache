 SG_ ESP_Diag_Mode : 16|1@1+ (1,0) [0|1] "" PSM
 SG_ Vref : 16|16@1+ (0.01,0) [0|655.35] "km/h" PSM
 SG_ PSM_TorqueReqSlow : 32|8@1+ (1,0) [0|255] "" PSM
 SG_ PSM_TorqueReqFast : 40|8@1+ (1,0) [0|255] "" PSM
 SG_ Engagement_Torque : 48|8@1+ (0.39,0) [0|99.45] "%" PSM
 SG_ PSM_LateralAccel : 56|8@1+ (1,0) [0|255] "" PSM

